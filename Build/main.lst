  26:Core/Src/main.c ****         uint32_t button1_state = GPIOC_IDR & GPIOC_IDR_PIN13;
  27:Core/Src/main.c ****         uint32_t button2_state = GPIOC_IDR & GPIOC_IDR_PIN6;
  28:Core/Src/main.c **** 
  29:Core/Src/main.c ****         // ==================== 按钮1 逻辑 ====================
ARM GAS  C:\Users\36525\AppData\Local\Temp\cc7ZWpRZ.s 			page 2


  30:Core/Src/main.c ****         if (!button1_state) // 低电平有效
  31:Core/Src/main.c ****         {
  32:Core/Src/main.c ****             if (!button1_pressed)
  33:Core/Src/main.c ****             {
  34:Core/Src/main.c ****                 button1_pressed = 1;
  35:Core/Src/main.c **** 
  36:Core/Src/main.c ****                 uint8_t all_done = 1;
  37:Core/Src/main.c ****                 if (button1_mode == 0) // 开灯模式
  38:Core/Src/main.c ****                 {
  39:Core/Src/main.c ****                     // 正向操作 (0→1→2)
  40:Core/Src/main.c ****                     for (int i = 0; i < 3; i++)
  41:Core/Src/main.c ****                     {
