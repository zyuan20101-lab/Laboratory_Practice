   1:Core/Src/main.c **** #include "init.h"
   2:Core/Src/main.c **** #include <stdint.h>
   3:Core/Src/main.c **** 
   4:Core/Src/main.c **** // ==================== 全局变量 ====================
   5:Core/Src/main.c **** uint8_t led_states[3] = {0}; // 记录每个 LED 的当前状态 (0=关闭, 1=打开)
   6:Core/Src/main.c ****                                 // led_states[0] 对应 LED1 (PB0)
   7:Core/Src/main.c ****                                 // led_states[1] 对应 LED2 (PB7)
   8:Core/Src/main.c ****                                 // led_states[2] 对应 LED3 (PB14)
   9:Core/Src/main.c **** uint8_t button1_mode = 0;      // 按钮1的功能模式 (0=开灯, 1=关灯)
  10:Core/Src/main.c **** uint8_t button1_pressed = 0;   // 按钮1是否被按下
  11:Core/Src/main.c **** uint8_t button2_pressed = 0;   // 按钮2是否被按下
  12:Core/Src/main.c **** 
  13:Core/Src/main.c **** // ==================== 函数原型 ====================
  14:Core/Src/main.c **** void update_leds(void);
  15:Core/Src/main.c **** void delay(volatile uint32_t s);
  16:Core/Src/main.c **** 
  17:Core/Src/main.c **** int main(void)
  18:Core/Src/main.c **** {
  19:Core/Src/main.c ****     // 初始化 GPIO 引脚
  20:Core/Src/main.c ****     GPIO_Ini_1(); // 初始化 LED 引脚 (PB0, PB7, PB14)
  21:Core/Src/main.c ****     GPIO_Ini_2(); // 初始化按钮引脚 (PC6, PC13)
  22:Core/Src/main.c **** 
  23:Core/Src/main.c ****     while (1)
  24:Core/Src/main.c ****     {
  25:Core/Src/main.c ****         // 读取按钮1 (PC13) 和按钮2 (PC6) 的状态
  26:Core/Src/main.c ****         uint32_t button1_state = GPIOC_IDR & GPIOC_IDR_PIN13;
  27:Core/Src/main.c ****         uint32_t button2_state = GPIOC_IDR & GPIOC_IDR_PIN6;
  28:Core/Src/main.c **** 
  29:Core/Src/main.c ****         // ==================== 按钮1 逻辑 ====================
  30:Core/Src/main.c ****         if (!button1_state) // 按钮1按下时，IDR对应位为低电平
ARM GAS  C:\Users\36525\AppData\Local\Temp\ccUINTJg.s 			page 2


  31:Core/Src/main.c ****         {
  32:Core/Src/main.c ****             if (!button1_pressed)
  33:Core/Src/main.c ****             {
  34:Core/Src/main.c ****                 button1_pressed = 1;
  35:Core/Src/main.c **** 
  36:Core/Src/main.c ****                 if (button1_mode == 0) // 开灯模式
  37:Core/Src/main.c ****                 {
  38:Core/Src/main.c ****                     // 按顺序开灯：PB0 -> PB7 -> PB14
  39:Core/Src/main.c ****                     for (int i = 0; i < 3; i++)
  40:Core/Src/main.c ****                     {
  41:Core/Src/main.c ****                         if (led_states[i] == 0)
  42:Core/Src/main.c ****                         {
  43:Core/Src/main.c ****                             led_states[i] = 1; // 打开对应 LED
  44:Core/Src/main.c ****                             break; // 只打开一个 LED
  45:Core/Src/main.c ****                         }
  46:Core/Src/main.c ****                     }
  47:Core/Src/main.c ****                 }
  48:Core/Src/main.c ****                 else // 关灯模式
  49:Core/Src/main.c ****                 {
  50:Core/Src/main.c ****                     // 按顺序关灯：PB14 -> PB7 -> PB0
  51:Core/Src/main.c ****                     for (int i = 2; i >= 0; i--)
  52:Core/Src/main.c ****                     {
  53:Core/Src/main.c ****                         if (led_states[i] == 1)
  54:Core/Src/main.c ****                         {
  55:Core/Src/main.c ****                             led_states[i] = 0; // 关闭对应 LED
  56:Core/Src/main.c ****                             break; // 只关闭一个 LED
  57:Core/Src/main.c ****                         }
  58:Core/Src/main.c ****                     }
  59:Core/Src/main.c ****                 }
  60:Core/Src/main.c **** 
  61:Core/Src/main.c ****                 update_leds(); // 更新 LED 状态
  62:Core/Src/main.c ****             }
  63:Core/Src/main.c ****         }
  64:Core/Src/main.c ****         else
  65:Core/Src/main.c ****         {
  66:Core/Src/main.c ****             button1_pressed = 0; // 按钮1释放
  67:Core/Src/main.c ****         }
  68:Core/Src/main.c **** 
  69:Core/Src/main.c ****         // ==================== 按钮2 逻辑 ====================
  70:Core/Src/main.c ****         if (!button2_state) // 按钮2按下时，IDR对应位为低电平
  71:Core/Src/main.c ****         {
  72:Core/Src/main.c ****             if (!button2_pressed)
  73:Core/Src/main.c ****             {
  74:Core/Src/main.c ****                 button2_pressed = 1;
  75:Core/Src/main.c ****                 button1_mode = !button1_mode; // 切换按钮1的功能模式
  76:Core/Src/main.c ****             }
  77:Core/Src/main.c ****         }
  78:Core/Src/main.c ****         else
  79:Core/Src/main.c ****         {
  80:Core/Src/main.c ****             button2_pressed = 0; // 按钮2释放
  81:Core/Src/main.c ****         }
  82:Core/Src/main.c **** 
  83:Core/Src/main.c ****         // ==================== 防抖延时 ====================
  84:Core/Src/main.c ****         delay(100000); // 简单延时用于按键防抖
  85:Core/Src/main.c ****     }
  86:Core/Src/main.c **** }
  87:Core/Src/main.c **** 
