  47:Core/Src/main.c ****                         }
  48:Core/Src/main.c ****                     }
  49:Core/Src/main.c ****                 }
  50:Core/Src/main.c ****                 else // 关灯模式
  51:Core/Src/main.c ****                 {
  52:Core/Src/main.c ****                     // 反向操作 (2→1→0)
