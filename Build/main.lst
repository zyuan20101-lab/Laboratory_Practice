  58:Core/Src/main.c ****                             all_done = 0;
  59:Core/Src/main.c ****                             break;
  60:Core/Src/main.c ****                         }
  61:Core/Src/main.c ****                     }
  62:Core/Src/main.c ****                 }
  63:Core/Src/main.c **** 
  64:Core/Src/main.c ****                 update_leds();
  65:Core/Src/main.c ****             }
  66:Core/Src/main.c ****         }
  67:Core/Src/main.c ****         else
  68:Core/Src/main.c ****         {
