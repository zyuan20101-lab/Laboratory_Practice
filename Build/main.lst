  91:Core/Src/main.c **** // ==================== 更新 LED 状态函数 ====================
  92:Core/Src/main.c **** void update_leds(void)
  93:Core/Src/main.c **** {
  94:Core/Src/main.c ****     // 先关闭所有 LED
  95:Core/Src/main.c ****     GPIOB_BSRR = GPIOB_BSRR_PIN0_RESET | GPIOB_BSRR_PIN7_RESET | GPIOB_BSRR_PIN14_RESET;
  96:Core/Src/main.c ****     
  97:Core/Src/main.c ****     // 等待一小段时间确保LED关闭
  98:Core/Src/main.c ****     delay(1000);
  99:Core/Src/main.c **** 
 100:Core/Src/main.c ****     // 根据 led_states 数组打开相应的 LED
 101:Core/Src/main.c ****     uint32_t bsrr_value = 0;
 102:Core/Src/main.c ****     if (led_states[0])
 103:Core/Src/main.c ****         bsrr_value |= GPIOB_BSRR_PIN0_SET;
 104:Core/Src/main.c ****     if (led_states[1])
 105:Core/Src/main.c ****         bsrr_value |= GPIOB_BSRR_PIN7_SET;
 106:Core/Src/main.c ****     if (led_states[2])
 107:Core/Src/main.c ****         bsrr_value |= GPIOB_BSRR_PIN14_SET;
 108:Core/Src/main.c ****     
 109:Core/Src/main.c ****     // 一次性设置所有LED状态
 110:Core/Src/main.c ****     GPIOB_BSRR = bsrr_value;
 111:Core/Src/main.c **** }
